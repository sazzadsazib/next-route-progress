{
  "name": "next-route-progressbar",
  "version": "1.0.4",
  "description": "A lightweight Next.js route change progress bar",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sazzadsazib/next-route-progressbar.git"
  },
  "keywords": [
    "nextjs",
    "progress-bar",
    "route",
    "navigation",
    "react",
    "app-router"
  ],
  "author": "Sazzadul Islam <sazib66@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sazzadsazib/next-route-progressbar#readme",
  "bugs": {
    "url": "https://github.com/sazzadsazib/next-route-progressbar/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "@types/react": "^18.3.10",
    "@types/node": "^20.11.30"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "next": ">=13"
  }
}
